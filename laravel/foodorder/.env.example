APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodorder
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- FoodOrder ---
# Impuesto aplicado a los pedidos (0.13 = 13 %)
TASA_IMPUESTO=0.13
# Orígenes permitidos por CORS (lista separada por comas). "*" = cualquiera (solo desarrollo)
CORS_ALLOWED_ORIGINS=*

# Wompi El Salvador: usar un negocio en modo desarrollo para pruebas.
# Nunca publicar estas credenciales ni configurarlas en Ionic/Vue.
WOMPI_CLIENT_ID=
WOMPI_CLIENT_SECRET=
WOMPI_PRODUCTION=false
# Opcional: URL pública HTTPS de retorno al frontend web.
WOMPI_RETURN_URL=

# Facturación electrónica (DTE-01) mediante proveedor Lumen; opcional.
# Es una integración a un servicio tercero, que puede requerir contrato y costos.
# Requiere empresa autorizada para emitir DTE y credenciales fiscales registradas en el proveedor.
# Por defecto no emite ni transmite ningún documento fiscal.
DTE_LUMEN_ENABLED=false
DTE_LUMEN_PRODUCTION=false
DTE_LUMEN_PRODUCTION_CONFIRMED=false
DTE_LUMEN_API_KEY=
DTE_LUMEN_COMPANY_NRC=
DTE_LUMEN_ESTABLISHMENT=
DTE_LUMEN_POINT_OF_SALE=
